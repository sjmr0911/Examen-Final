# ================================
# STR - Sistema de Tiempo Real
# Configuración de entorno
# ================================

# Entorno de ejecución
APP_ENV=development

# Puerto del servidor FastAPI
PORT=8000

# ================================
# Base de Datos
# ================================

# Ruta de la base de datos SQLite
DB_PATH=incidents.db

# ================================
# Parámetros STR (Tiempo Real)
# ================================

# Deadline máximo en milisegundos
DEADLINE_MS=50

# Máximo tiempo permitido en cola (ms)
MAX_START_DELAY=20

# Intervalo mínimo entre eventos (segundos)
MIN_INTERVAL=0.01

# Tamaño máximo de la cola
QUEUE_MAXSIZE=100

# Número de workers concurrentes
NUM_WORKERS=3

# Máximo de incidencias críticas simultáneas
MAX_CRITICAL_CONCURRENT=2

# ================================
# Logging
# ================================

# Nivel de logs (INFO, DEBUG, ERROR)
LOG_LEVEL=INFO

# ================================
# Notas
# ================================

# Copia este archivo como ".env" y ajusta los valores según tu entorno.
# Ejemplo:
# cp .env.example .env